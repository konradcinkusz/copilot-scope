# Copy to .env and fill in — docker compose reads .env automatically for the
# ${VAR} substitutions in the compose files. .env is gitignored; never commit
# real values. There is deliberately no default: the compose files fail with a
# clear message if these are unset, so a known placeholder can never silently
# become a production credential.

# Ingest key. Gates OTLP ingest (/v1), the Prometheus scrape (/metrics) and the
# query API (/api). Generate one, e.g.:  openssl rand -hex 24
COPILOTSCOPE_API_KEY=

# Password for the bundled Postgres. Generate one, e.g.:  openssl rand -hex 16
POSTGRES_PASSWORD=
