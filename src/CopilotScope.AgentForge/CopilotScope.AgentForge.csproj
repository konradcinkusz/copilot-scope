<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CopilotScope.AgentForge</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reuses SessionDetailDto/TranscriptEntry directly so the persona profile can never
         drift from what the Collector actually serves. -->
    <ProjectReference Include="..\CopilotScope.Collector\CopilotScope.Collector.csproj" />
    <ProjectReference Include="..\CopilotScope.ServiceDefaults\CopilotScope.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Versions verified on nuget.org 2026-08-08 (see docs/AGENTFORGE.md) — this space moves
         fast, re-verify before bumping. Microsoft Agent Framework wraps the Azure OpenAI-
         compatible client as an AIAgent; Azure AI Foundry model deployments are reached through
         that same endpoint shape. -->
    <PackageReference Include="Microsoft.Agents.AI" Version="1.17.0" />
    <PackageReference Include="Azure.AI.OpenAI" Version="2.1.0" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <!-- Provides ChatClient.AsIChatClient(), the adapter from the OpenAI SDK's client to the
         Microsoft.Extensions.AI.IChatClient that Microsoft.Agents.AI's AsAIAgent() extends. -->
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.9.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CopilotScope.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded (not CopyToOutputDirectory) so it loads correctly regardless of the host
         process's base directory — including when CopilotScope.Tests references this project. -->
    <EmbeddedResource Include="Agents\PersonaSystemPromptTemplate.txt" />
  </ItemGroup>

  <!-- Both this project and the CopilotScope.Collector project it references are web
       projects carrying appsettings.json, so the referenced project's copies land at the
       same publish-relative path as this project's own. That is error NETSDK1152, and it
       is why neither of these images has ever built.

       Suppressing it with ErrorOnDuplicatePublishOutputFiles would be worse than the
       error: whichever copy won is unspecified, and if the collector's won this service
       would silently read the collector's configuration as its own — pricing, keys,
       history and all. The reference exists only for domain types and DTOs, so the
       referenced project's copies are dropped from the publish list and this project's
       own are kept. Publish-time only: `dotnet build` and the test suite never compute
       this list, which is why the solution build has always been green. -->
  <Target Name="DropReferencedAppSettingsFromPublish"
          AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish
          Remove="@(ResolvedFileToPublish)"
          Condition="$([System.String]::Copy('%(RelativePath)').StartsWith('appsettings')) AND !$([System.String]::Copy('%(FullPath)').StartsWith('$(MSBuildProjectDirectory)'))" />
    </ItemGroup>
  </Target>

</Project>
