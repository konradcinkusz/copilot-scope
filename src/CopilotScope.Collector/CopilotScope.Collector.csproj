<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CopilotScope.Collector</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The only external dependency is Npgsql (persistence). OTLP decoding is
         implemented in-repo, everything else comes from the shared framework. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CopilotScope.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CopilotScope.ServiceDefaults\CopilotScope.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Compiled in as well as copied out: a host running this application inside its own
         process (the native copilotscope binary, ADR-004) has no appsettings.json beside it,
         and falls back to this one. See ServiceDefaults' AddEmbeddedDefaults. -->
    <EmbeddedResource Include="appsettings.json" LogicalName="CopilotScope.Collector.appsettings.json" />
  </ItemGroup>

</Project>
