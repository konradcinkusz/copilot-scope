<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\CopilotScope.ServiceDefaults\CopilotScope.ServiceDefaults.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CopilotScope.Dashboard</RootNamespace>
    <!-- Blazor Server is part of the ASP.NET Core shared framework — no NuGet needed.
         Realtime feel comes from a 2 s polling loop against the collector API; swap in
         Microsoft.AspNetCore.SignalR.Client if push semantics are ever required. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Compiled in as well as copied out: a host running this application inside its own
         process (the native copilotscope binary, ADR-004) has no appsettings.json beside it,
         and falls back to this one. See ServiceDefaults' AddEmbeddedDefaults. -->
    <EmbeddedResource Include="appsettings.json" LogicalName="CopilotScope.Dashboard.appsettings.json" />
  </ItemGroup>

</Project>
