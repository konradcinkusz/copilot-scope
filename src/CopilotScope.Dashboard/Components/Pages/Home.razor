@page "/"
@* Deep link to one session. Selection used to be component state only, so a session could not
   be linked, bookmarked or pasted into a review — and Overview's "top sessions" links went to
   the list and left the reader to find the row. *@
@page "/sessions/{SessionId}"

<PageTitle>CopilotScope</PageTitle>

<header class="topbar">
    <h1 class="brand">Copilot<span>Scope</span></h1>
    <nav class="nav" aria-label="Main">
        <a href="/" class="active" aria-current="page">Sessions</a>
        <a href="/overview">Overview</a>
        <a href="/docs">Docs</a>
    </nav>
    @if (_sessions is { Count: > 0 })
    {
        <div class="view-mode-row" role="radiogroup" aria-label="Detail level">
            <span class="view-mode-label">View:</span>
            <button class="view-btn @(_viewMode == ViewMode.Basic    ? "active" : "")" role="radio" aria-checked="@(_viewMode == ViewMode.Basic)"    title="The headline verdict — score, what's driving it, key counts" @onclick="() => SetViewModeAsync(ViewMode.Basic)">Basic</button>
            <button class="view-btn @(_viewMode == ViewMode.Advanced ? "active" : "")" role="radio" aria-checked="@(_viewMode == ViewMode.Advanced)" title="All panels — only tiles with actual data" @onclick="() => SetViewModeAsync(ViewMode.Advanced)">Advanced</button>
            <button class="view-btn @(_viewMode == ViewMode.Full     ? "active" : "")" role="radio" aria-checked="@(_viewMode == ViewMode.Full)"     title="All panels including no-data placeholders" @onclick="() => SetViewModeAsync(ViewMode.Full)">Full</button>
        </div>
    }
    <div class="conn @(_health is null ? "down" : "up")" role="status" aria-live="polite">
        @if (_health is null)
        {
            <text>collector unreachable</text>
        }
        else
        {
            <text>@_health.Environment · @_health.Sessions sessions · @(_health.Persistence ? "Postgres" : "in-memory")@(_health.Forwarding ? " · forwarding" : "")</text>
        }
    </div>
    @if (Auth.Enabled)
    {
        @* Plain form post: signing out clears an HTTP cookie, which the interactive
           circuit cannot do on its own. *@
        <form method="post" action="/logout" class="signout-form">
            <span class="signout-role">@(_canDelete ? "admin" : "viewer")</span>
            <button class="signout-btn" type="submit">Sign out</button>
        </form>
    }
</header>

<div class="grid">
    <aside class="rail">
        <div class="rail-title">
            @* When history exceeds the rail page, say so — the rest is in Postgres, not lost. *@
            <span>Sessions @if (_sessions is { Count: > 0 })
                {
                    <em class="rail-count" title="@(_sessionTotal > FilteredSessions.Count ? $"Showing the newest {FilteredSessions.Count} of {_sessionTotal} stored sessions" : "")">
                        @FilteredSessions.Count@(_sessionTotal > FilteredSessions.Count ? $" / {_sessionTotal}" : "")
                    </em>
                }</span>
            @if (_viewMode != ViewMode.Basic)
            {
                <div class="rail-controls">
                    <label class="toggle-internal">
                        <input type="checkbox" checked="@_showInternal" @onchange="e => ToggleShowInternalAsync((bool)e.Value!)" />
                        Internal
                    </label>
                    <label class="toggle-internal">
                        <input type="checkbox" checked="@_repoNormalization" @onchange="e => SetRepoNormalizationAsync((bool)e.Value!)" />
                        Normalize by repo
                    </label>
                </div>
            }
        </div>

        @if (_sessions is { Count: > 0 })
        {
            <div class="rail-search">
                <input type="search" placeholder="Filter by id, repo or branch…" aria-label="Filter sessions"
                       value="@_filter" @oninput="e => _filter = e.Value?.ToString() ?? string.Empty" />
            </div>
        }

        @* Window and cohort. The rail is the session list, so the filters that narrow it live
           here; the aggregate versions of the same filters are on Overview. No developer axis
           on either — see docs/PRIVACY.md. *@
        <div class="rail-filters">
            <div class="filter-row">
                @foreach (var (label, value) in Ranges)
                {
                    <button class="chip @(_days == value ? "active" : "")"
                            @onclick="() => SetRangeAsync(value)">@label</button>
                }
            </div>
            <div class="filter-row">
                <select value="@_repository" @onchange="e => SetRepositoryAsync(e.Value?.ToString())">
                    <option value="">All repositories</option>
                    @foreach (var r in _facets?.Repositories ?? []) { <option value="@r">@r</option> }
                </select>
                <select value="@_emitter" @onchange="e => SetEmitterAsync(e.Value?.ToString())">
                    <option value="">All assistants</option>
                    @foreach (var a in _facets?.Assistants ?? []) { <option value="@a">@a</option> }
                </select>
            </div>
        </div>

        @if (MixedAssistants)
        {
            @* The composite renormalizes over the components that have data, so a score built on
               four components is not the same measurement as one built on six. Reading them side
               by side is the obvious mistake, and it used to go unwarned. *@
            <div class="comparability-note" role="note">
                This list mixes assistants. Scores are comparable <b>within</b> an assistant and
                <b>directional across</b> them — different assistants report different signals, so
                their scores rest on different evidence.
                <a href="/docs#coverage">What each assistant reports</a>
            </div>
        }

        @if (_privacy?.Enabled == true)
        {
            @* A works-council deployment: identity is pseudonymized at ingest, prompts and
               responses are never stored, and views below the aggregation floor do not render.
               Saying so on screen is part of the point — the people being measured should be
               able to see what the tool can and cannot do without reading the config. *@
            <div class="privacy-note" role="note">
                <b>Privacy mode.</b> Identities are pseudonymized, prompts and responses are not
                stored, and views covering fewer than @_privacy.MinimumGroupSize developers are
                withheld. <a href="/docs#privacy">What is collected</a>
            </div>
        }

        <div class="rail-list">
        @if (_sessions is null)
        {
            <div class="empty">Connecting to the collector…</div>
        }
        else if (_suppressed is not null)
        {
            @* Not an error and not an empty database: the floor did its job. Say which, or the
               operator debugs a collector that is working exactly as configured. *@
            <div class="empty">
                @_suppressed
                <br /><br />
                <a href="/docs#privacy">Why views are withheld</a>
            </div>
        }
        else if (_sessions.Count == 0)
        {
            <div class="empty">
                No sessions yet. Enable OTel in VS Code, run Claude Code or Copilot CLI with OTel env vars, or start the demo generator:
                <code>dotnet run --project tools/CopilotScope.TelemetryGen</code>
                See <a href="/docs#sources">Docs → Supported sources</a> for setup instructions.
            </div>
        }
        else if (FilteredSessions.Count == 0)
        {
            <div class="empty">No session matches “@_filter”.</div>
        }
        else
        {
            @foreach (var s in FilteredSessions)
            {
                var ri = RepoColorIndex(s.Repository);
                var status = SessionStatus(s);
                <button class="session @(s.Id == _selectedId ? "active" : "") @(ri >= 0 ? $"repo-l{ri}" : "")"
                        aria-pressed="@(s.Id == _selectedId)" @onclick="() => SelectAsync(s.Id)">
                    <span class="session-id">
                        <span class="dot status-dot-@status.Css" title="@status.Label"></span>
                        @s.Id
                        @if (s.Kind != SessionKind.UserChat)
                        {
                            <span class="session-kind-badge">@KindLabel(s.Kind)</span>
                        }
                        @if (s.Origin == SessionOrigin.LogImport)
                        {
                            @* Reconstructed from the assistant's own transcript file rather than
                               received live. It carries no latency or edit-decision signal, so its
                               score rests on less evidence — which a reader comparing two scores
                               has to be able to see. *@
                            <span class="session-kind-badge origin-import"
                                  title="Reconstructed from a local transcript file. No latency, edit-decision or feedback signal — those are OTel events the transcript does not record, so this session is scored with lower confidence.">imported</span>
                        }
                    </span>
                    <span class="session-meta">
                        @if (RepoShortName(s.Repository) is { } rn) { <span class="repo-chip repo-c@(ri)">@rn</span> }
                        @s.ChatCalls chat · @s.ToolCalls tools · @Ago(s.LastSeen)
                    </span>
                    <span class="session-score @AbsoluteGradeClass(s.Quality)" aria-label="Score @s.Quality.Score.ToString("0") — @s.Quality.Grade">
                        @s.Quality.Score.ToString("0")
                        <span class="session-grade">@s.Quality.Grade</span>
                    </span>
                </button>
            }
        }
        </div>
    </aside>

    <section class="main">
        @if (DetailSuppressed)
        {
            <div class="empty big">
                <div class="empty-title">Per-session detail is off</div>
                This collector runs in privacy mode. A single session covers one person, which is
                below any aggregation floor, so the detail view is disabled rather than
                pseudonymized — use the overview and the aggregate reports instead.
                <br /><br />
                <a href="/docs#privacy">What privacy mode enforces</a>
            </div>
        }
        else if (_detail is null)
        {
            <div class="empty big">
                <div class="empty-title">No session selected</div>
                Pick one from the list on the left. You'll get its quality score and what drove it —
                switch to <b>Advanced</b> (top right) for per-turn analysis, tool usage and the live event feed.
            </div>
        }
        else
        {
            var s = _detail.Summary;
            var q = s.Quality;

            <div class="panel vu-panel">
                <div class="panel-head">
                    <div>
                        <div class="panel-label">Session quality</div>
                        <div class="vu-score @AbsoluteGradeClass(q)">@q.Score.ToString("0.0") <small>@(_viewMode == ViewMode.Basic ? $"/ 100 · {q.Grade}" : QualitySubtitle(q, s.Repository, _repoNormalization))</small></div>
                    </div>
                    <div class="head-actions">
                        <div class="panel-sub">@s.Id</div>
                        @{ var status = SessionStatus(s); }
                        <span class="status-chip status-@status.Css">@status.Label</span>
                        @if (_viewMode != ViewMode.Basic)
                        {
                            if (s.EmitterKind != EmitterKind.Unknown)
                            {
                                <span class="status-chip emitter-@s.EmitterKind.ToString().ToLower()">@EmitterLabel(s.EmitterKind)</span>
                            }
                            var maturity = SessionMaturity(s.Turns);
                            <span class="status-chip @maturity.Css" title="Session maturity based on @s.Turns turn@(s.Turns == 1 ? "" : "s")">@maturity.Label</span>
                            @* Deletion is irreversible, so it stays with the admin role when
                               sign-in is enabled. With auth off this is unchanged. *@
                            if (_canDelete)
                            {
                                if (_confirmDelete)
                                {
                                    <button class="btn danger" @onclick="DeleteAsync">Confirm delete</button>
                                    <button class="btn" @onclick="() => _confirmDelete = false">Cancel</button>
                                }
                                else
                                {
                                    <button class="btn" @onclick="() => _confirmDelete = true">Delete session</button>
                                }
                            }
                        }
                    </div>
                </div>

                @* ---- Basic view: the whole story on one screen, no scrolling required ---- *@
                @if (_viewMode == ViewMode.Basic)
                {
                    <div class="basic-meter">
                        <div class="basic-track" role="img" aria-label="Quality score @q.Score.ToString("0.0") out of 100, grade @q.Grade">
                            <span class="basic-zone-tick" style="left:40%"></span>
                            <span class="basic-zone-tick" style="left:55%"></span>
                            <span class="basic-zone-tick" style="left:70%"></span>
                            <span class="basic-zone-tick" style="left:85%"></span>
                            <span class="basic-fill @AbsoluteGradeClass(q)" style="width:@(Pct(q.Score / 100))%"></span>
                        </div>
                        <div class="basic-zones" aria-hidden="true">
                            <span style="flex:40">critical</span>
                            <span style="flex:15">poor</span>
                            <span style="flex:15">fair</span>
                            <span style="flex:15">good</span>
                            <span style="flex:15">excellent</span>
                        </div>
                    </div>

                    <p class="basic-verdict">
                        <span class="dot dot-@GradeDotClass(q.Grade)"></span>@BasicVerdict(q)
                    </p>

                    var weakest = WorstComponent(q);
                    var strongest = BestComponent(q);
                    if (weakest is not null || strongest is not null)
                    {
                        <div class="basic-drivers">
                            @if (weakest is not null)
                            {
                                <div class="basic-driver d-@TrafficClass(weakest)">
                                    <div class="basic-driver-head">
                                        <span><span class="dot dot-@TrafficClass(weakest)"></span>Holding it back — <b>@weakest.Name</b></span>
                                        <span>@((weakest.Value * 100).ToString("0"))</span>
                                    </div>
                                    <div class="bar"><span style="width:@(Pct(weakest.Value))%"></span></div>
                                    <div class="component-detail">@weakest.Detail</div>
                                </div>
                            }
                            @if (strongest is not null)
                            {
                                <div class="basic-driver d-@TrafficClass(strongest)">
                                    <div class="basic-driver-head">
                                        <span><span class="dot dot-@TrafficClass(strongest)"></span>Working well — <b>@strongest.Name</b></span>
                                        <span>@((strongest.Value * 100).ToString("0"))</span>
                                    </div>
                                    <div class="bar"><span style="width:@(Pct(strongest.Value))%"></span></div>
                                    <div class="component-detail">@strongest.Detail</div>
                                </div>
                            }
                        </div>
                    }

                    <div class="basic-stats">
                        <div class="basic-stat"><b>@s.Turns</b><span>turns</span></div>
                        <div class="basic-stat"><b>@s.ChatCalls<i>@(s.ChatErrors > 0 ? $" ({s.ChatErrors}✗)" : "")</i></b><span>LLM calls</span></div>
                        <div class="basic-stat"><b>@s.ToolCalls<i>@(s.ToolErrors > 0 ? $" ({s.ToolErrors}✗)" : "")</i></b><span>tool calls</span></div>
                        <div class="basic-stat"><b>@FmtTokens(s.InputTokens + s.OutputTokens)</b><span>tokens</span></div>
                        <div class="basic-stat"><b>@Duration(s)</b><span>duration</span></div>
                    </div>

                    <div class="basic-context">
                        <span>@(RepoShortName(s.Repository) ?? "no repo")</span>
                        <span>@(s.Branch ?? "no branch")</span>
                        @if (s.EmitterKind != EmitterKind.Unknown)
                        {
                            <span>@EmitterLabel(s.EmitterKind)</span>
                        }
                        <span>last activity @Ago(s.LastSeen)</span>
                        <button class="btn btn-sm basic-more" @onclick="() => SetViewModeAsync(ViewMode.Advanced)">Full breakdown →</button>
                    </div>
                }
                @if (_viewMode != ViewMode.Basic)
                {
                <div class="maturity-timeline" title="@s.Turns turn@(s.Turns == 1 ? "" : "s") in this session">
                    <div class="maturity-stages-row">
                        @{
                            var m0 = s.Turns <= 1 ? "mat-current" : "mat-passed";
                            var m1 = s.Turns is >= 2 and <= 4 ? "mat-current" : s.Turns > 4 ? "mat-passed" : "mat-future";
                            var m2 = s.Turns >= 5 ? "mat-current" : "mat-future";
                            var c0 = s.Turns >= 2 ? "mat-conn-done" : "";
                            var c1 = s.Turns >= 5 ? "mat-conn-done" : "";
                        }
                        <div class="mat-step @m0">
                            <div class="mat-node"></div>
                            <div class="mat-step-name">Early</div>
                            <div class="mat-step-range">0–1 turns</div>
                        </div>
                        <div class="mat-conn @c0"></div>
                        <div class="mat-step @m1">
                            <div class="mat-node"></div>
                            <div class="mat-step-name">Growing</div>
                            <div class="mat-step-range">2–4 turns</div>
                        </div>
                        <div class="mat-conn @c1"></div>
                        <div class="mat-step @m2">
                            <div class="mat-node"></div>
                            <div class="mat-step-name">Established</div>
                            <div class="mat-step-range">5+ turns</div>
                        </div>
                    </div>
                    <div class="mat-turn-note">@s.Turns turn@(s.Turns == 1 ? "" : "s")</div>
                </div>
                }
                @if (_viewMode != ViewMode.Basic)
                {
                <div class="vu" title="@(q.PercentileRank.HasValue && _repoNormalization ? $"Raw score {q.Score:0.0}/100 · {(int)(q.PercentileRank.Value * 100)}th percentile vs {q.HistoryCount} {(s.Repository != null ? "repo " : "")}sessions" : $"Raw score {q.Score:0.0}/100")">
                    @for (var i = 0; i < 40; i++)
                    {
                        var lit = q.Score / 100.0 * 40 > i;
                        // When history available, the mean marker segment gets a distinct style
                        var isMean = q.HistoryMean.HasValue && Math.Abs(q.HistoryMean.Value / 100.0 * 40 - i) < 0.5;
                        <span class="vu-seg @(lit ? SegClass(i) : "") @(isMean && !lit ? "vu-mean" : "")"></span>
                    }
                </div>
                @if (q.PercentileRank.HasValue && q.HistoryCount >= 3 && _repoNormalization)
                {
                    <div class="percentile-bar">
                        <div class="percentile-fill" style="width:@(Pct(q.PercentileRank.Value))%"></div>
                        <span class="percentile-label">@((int)(q.PercentileRank.Value * 100))th pct vs @q.HistoryCount @(s.Repository != null ? "repo " : "")sessions</span>
                    </div>
                }
                var worst = WorstComponent(q);
                @if (worst is not null)
                {
                    <div class="worst-factor">
                        <span class="dot dot-@TrafficClass(worst)"></span>
                        Biggest drag on quality: <b>@worst.Name</b> (@((worst.Value * 100).ToString("0"))/100) — @worst.Detail
                    </div>
                }
                var priorForEmitter = EmitterCoverage.PriorComponents(s.EmitterKind);
                @if (priorForEmitter.Count > 0)
                {
                    <div class="mode-note">
                        <b>@EmitterLabel(s.EmitterKind)</b> never reports
                        @string.Join(", ", priorForEmitter), so
                        @(priorForEmitter.Count == 1 ? "that component is" : "those components are")
                        scored as a prior and the composite is renormalized over the rest. This
                        score is comparable with other @EmitterLabel(s.EmitterKind) sessions, and
                        directional against other assistants.
                    </div>
                }
                @if (q.Mode is SessionMode.Autonomous or SessionMode.SupervisedAgent)
                {
                    <div class="mode-note">
                        Scored as an <b>@q.ModeLabel</b> run. Time-to-first-token and edit acceptance
                        measure a person waiting and deciding; on a delegated run neither is present,
                        so this session is weighted on friction and reliability instead.
                    </div>
                }
                <div class="components">
                    @foreach (var c in q.Components)
                    {
                        // Certain factors are VS Code–only; mark them clearly for CLI sessions
                        var isCliNa = IsCli(s) && c.Samples == 0 && c.Name is "acceptance" or "feedback";
                        // A zero weight means this session's mode excludes the factor: it was
                        // computed but does not measure anything here (see the mode note above).
                        var notScored = c.Weight == 0;
                        <div class="component @(isCliNa || notScored ? "component-na" : "")">
                            <div class="component-head">
                                <span><span class="dot dot-@(isCliNa || notScored ? "unknown" : TrafficClass(c))"></span>@c.Name <em>@(notScored ? "not scored" : $"w={c.Weight:0.00}")</em></span>
                                <span>@(isCliNa ? "—" : (c.Value * 100).ToString("0"))</span>
                            </div>
                            @if (!isCliNa) { <div class="bar"><span style="width:@(Pct(c.Value))%"></span></div> }
                            <div class="component-detail">
                                @(isCliNa ? "not emitted by CLI"
                                  : notScored ? $"{c.Detail} · excluded for {q.ModeLabel} sessions"
                                  : c.Detail + (c.Samples == 0 ? " · prior" : ""))
                            </div>
                        </div>
                    }
                </div>
                }
            </div>

            @if (_viewMode != ViewMode.Basic)
            {
                <div class="tiles">
                    @if (ShowTile("tokens_in", s))
                    {
                        <div class="tile" data-tip="Cumulative prompt tokens sent across all LLM calls in this session — includes cached tokens re-sent each call. See Docs → Token semantics for why this is often large." tabindex="0"><b>@FmtTokens(s.InputTokens)</b><span>tokens in</span></div>
                    }
                    @if (ShowTile("tokens_out", s))
                    {
                        <div class="tile" data-tip="Text the model generated for you. Main driver of response time and cost. Source: gen_ai.usage.output_tokens (VS Code + CLI)." tabindex="0"><b>@FmtTokens(s.OutputTokens)</b><span>tokens out</span></div>
                    }
                    @if (ShowTile("cache_read", s))
                    {
                        <div class="tile" data-tip="Prompt tokens served from the model's cache — a subset of tokens in, not additional. High ratio means context is being reused efficiently across calls. (VS Code + CLI, model-dependent)" tabindex="0"><b>@FmtTokens(s.CacheReadTokens)</b><span>cache read</span></div>
                    }
                    @if (ShowTile("net_compute", s))
                    {
                        <div class="tile" data-tip="Tokens actually freshly computed by the model: tokens in − cache read. This is the GPU work that happened — the rest was served from cache at negligible cost." tabindex="0"><b>@FmtTokens(Math.Max(0, s.InputTokens - s.CacheReadTokens))</b><span>net compute</span></div>
                    }
                    @if (ShowTile("ttft_p50", s))
                    {
                        <div class="tile" data-tip="Median wait before the first token appears — the 'how snappy does it feel' number. Under ~1 s feels instant; over 2 s breaks flow. (VS Code + CLI)" tabindex="0"><b>@s.TtftP50Ms.ToString("0") ms</b><span>TTFT p50</span></div>
                    }
                    @if (ShowTile("ttft_p95", s))
                    {
                        <div class="tile" data-tip="95th percentile of first-token wait — the slow outliers. A high p95 with a good p50 means occasional stalls. (VS Code + CLI)" tabindex="0"><b>@s.TtftP95Ms.ToString("0") ms</b><span>TTFT p95</span></div>
                    }
                    @if (ShowTile("llm_calls", s))
                    {
                        <div class="tile" data-tip="How many times the model was called (one turn often makes several). ✗ counts failed calls — rate limits, timeouts. (VS Code + CLI)" tabindex="0"><b>@s.ChatCalls<i>@(s.ChatErrors > 0 ? $" ({s.ChatErrors}✗)" : "")</i></b><span>LLM calls</span></div>
                    }
                    @if (ShowTile("tool_calls", s))
                    {
                        <div class="tile" data-tip="Tool executions the agent performed: file reads/edits, terminal commands, searches. ✗ counts tool failures. (VS Code + CLI)" tabindex="0"><b>@s.ToolCalls<i>@(s.ToolErrors > 0 ? $" ({s.ToolErrors}✗)" : "")</i></b><span>tool calls</span></div>
                    }
                    @if (ShowTile("turns", s))
                    {
                        <div class="tile" data-tip="Conversation turns vs agent invocations. Many turns per invocation can mean the agent needed a lot of back-and-forth to finish. (VS Code + CLI)" tabindex="0"><b>@s.Turns / @s.AgentInvocations</b><span>turns / invocations</span></div>
                    }
                    @if (ShowTile("edits", s))
                    {
                        <div class="tile" data-tip="Suggested edits you kept (✓) vs threw away (✗) — the most direct 'was it useful' signal. Editor-only: VS Code emits this, the CLI does not." tabindex="0"><b>@s.EditsAccepted✓ @s.EditsRejected✗</b><span>edits</span></div>
                    }
                    @if (ShowTile("thumbs", s))
                    {
                        <div class="tile" data-tip="Your explicit thumbs up/down clicks in the chat UI. VS Code only — the CLI has no feedback buttons." tabindex="0"><b>👍@s.ThumbsUp 👎@s.ThumbsDown</b><span>feedback</span></div>
                    }
                    @if (ShowTile("loc", s))
                    {
                        <div class="tile" data-tip="Lines of code added/removed by accepted suggestions. VS Code only — not emitted by the CLI." tabindex="0"><b>+@s.LinesAdded.ToString("0") −@s.LinesRemoved.ToString("0")</b><span>lines of code</span></div>
                    }
                </div>
            }

            @if (_viewMode != ViewMode.Basic && (_viewMode == ViewMode.Full || _detail.Turns.Turns.Count > 0))
            {
            <div class="panel">
                <div class="panel-label">Turn analysis — @_detail.Turns.Algorithm</div>
                @if (_detail.Turns.Turns.Count == 0)
                {
                    <div class="empty">No completed turns yet.</div>
                }
                else
                {
                    var allClean = _detail.Turns.Turns.All(t => t.Score >= 1.0);
                    var hasIssues = _detail.Turns.Turns.Where(t => t.Score < 1.0).ToList();

                    <div class="findings">
                        @foreach (var f in _detail.Turns.Findings)
                        {
                            <div class="finding">@f</div>
                        }
                    </div>

                    var turnsWithModel = _detail.Turns.Turns.Where(t => t.Model is not null).ToList();
                    var hasModelData = turnsWithModel.Count > 0;
                    var distinctModels = _detail.Turns.Turns.Select(t => t.Model).Distinct().Where(m => m != null).ToList();
                    var modelSwitchOccurred = distinctModels.Count > 1;
                    @if (hasModelData)
                    {
                        <div class="model-timeline" title="Model used per turn — each block is one turn">
                            <div class="model-timeline-label">Model timeline</div>
                            <div class="model-timeline-strip">
                                @{ string? prevModel = null; }
                                @foreach (var t in _detail.Turns.Turns)
                                {
                                    var isSwitch = prevModel is not null && t.Model is not null && t.Model != prevModel;
                                    <div class="model-seg @ModelSegCss(t.Model) @(isSwitch ? "model-switch" : "")"
                                         title="Turn @(t.Index + 1): @(t.Model ?? "(no model)")">
                                        <span class="model-seg-label">@ModelShortLabel(t.Model)</span>
                                    </div>
                                    prevModel = t.Model ?? prevModel;
                                }
                            </div>
                            @if (modelSwitchOccurred)
                            {
                                <div class="model-switch-note">Model changed during session — switch points marked with ▲</div>
                            }
                        </div>
                    }

                    @if (allClean)
                    {
                        <div class="turns-clean-banner">
                            <span class="dot dot-good"></span>
                            @_detail.Turns.Turns.Count turn@(_detail.Turns.Turns.Count == 1 ? "" : "s") · all clean
                            <button class="btn btn-sm turns-toggle" @onclick="() => _showAllTurns = !_showAllTurns">
                                @(_showAllTurns ? "hide ▲" : "show all ▼")
                            </button>
                        </div>
                        @if (_showAllTurns)
                        {
                            <div class="turns-list">
                                @foreach (var t in _detail.Turns.Turns)
                                {
                                    <div class="turn-row turn-row-compact">
                                        <span class="turn-idx">#@(t.Index + 1)</span>
                                        <span class="turn-reasons">@string.Join(" · ", t.Reasons)</span>
                                    </div>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        @* Show problematic turns prominently *@
                        @foreach (var t in hasIssues.OrderBy(t => t.Score))
                        {
                            <div class="turn-row @(t.Index == _detail.Turns.WorstIndex ? "worst" : "")">
                                <span class="turn-idx">#@(t.Index + 1)</span>
                                <div class="bar wide"><span style="width:@(Pct(t.Score))%"></span></div>
                                <span class="turn-score">@((t.Score * 100).ToString("0"))</span>
                                <span class="turn-reasons">@string.Join(" · ", t.Reasons)</span>
                            </div>
                        }

                        var cleanCount = _detail.Turns.Turns.Count - hasIssues.Count;
                        @if (cleanCount > 0)
                        {
                            <div class="turns-clean-banner">
                                <span class="dot dot-good"></span>
                                @cleanCount clean turn@(cleanCount == 1 ? "" : "s") with no issues
                                <button class="btn btn-sm turns-toggle" @onclick="() => _showAllTurns = !_showAllTurns">
                                    @(_showAllTurns ? "hide ▲" : "show all ▼")
                                </button>
                            </div>
                            @if (_showAllTurns)
                            {
                                <div class="turns-list">
                                    @foreach (var t in _detail.Turns.Turns.Where(t => t.Score >= 1.0))
                                    {
                                        <div class="turn-row turn-row-compact @(t.Index == _detail.Turns.BestIndex ? "best" : "")">
                                            <span class="turn-idx">#@(t.Index + 1)</span>
                                            <span class="turn-reasons">@string.Join(" · ", t.Reasons)</span>
                                        </div>
                                    }
                                </div>
                            }
                        }
                    }
                }
            </div>
            }

            @if (_viewMode != ViewMode.Basic)
            {
                var visInsights = _detail.Insights.Where(ShowInsight).ToList();
                if (visInsights.Count > 0)
                {
                    <div class="panel">
                        <div class="panel-label">Insights — algorithm reports</div>
                        <div class="insights">
                            @foreach (var r in visInsights)
                            {
                                <div class="insight @(r.Status == "no-data" ? "muted" : "")">
                                    <div class="insight-head">
                                        <span class="insight-name">
                                            @if (r.Score.HasValue && r.Status != "no-data")
                                            {
                                                <span class="dot dot-@InsightDotClass(r.Score)"></span>
                                            }
                                            @r.Name
                                        </span>
                                        @if (r.Score is { } sc)
                                        {
                                            <span class="insight-score @InsightTrafficClass(r.Score)">@((sc * 100).ToString("0"))</span>
                                        }
                                    </div>
                                    <div class="insight-algo">@r.Algorithm</div>
                                    @if (r.Score is { } sv)
                                    {
                                        <div class="bar"><span style="width:@(Pct(sv))%"></span></div>
                                    }
                                    @foreach (var m in r.Metrics)
                                    {
                                        <div class="kv"><span>@m.Label</span><b>@m.Value</b></div>
                                    }
                                    @foreach (var f in r.Findings)
                                    {
                                        <div class="insight-finding">@f</div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            }

            @if (_viewMode != ViewMode.Basic)
            {
            <div class="columns">
                <div class="panel">
                    <div class="panel-label">Tools</div>
                    @if (_detail.Tools.Count == 0)
                    {
                        <div class="empty">No tool calls.</div>
                    }
                    else
                    {
                        var max = Math.Max(1, _detail.Tools.Max(t => t.Calls));
                        @foreach (var t in _detail.Tools)
                        {
                            <div class="tool-row">
                                <span class="tool-name">@t.Name</span>
                                <div class="bar wide">
                                    <span style="width:@(Pct(1.0 * t.Calls / max))%"></span>
                                </div>
                                <span class="tool-meta">@t.Calls×@(t.Errors > 0 ? $" · {t.Errors}✗" : "") · @t.AvgMs.ToString("0") ms</span>
                            </div>
                        }
                    }
                </div>

                <div class="panel">
                    <div class="panel-label">Models</div>
                    @foreach (var m in s.Models.OrderByDescending(m => m.Value))
                    {
                        <div class="tool-row">
                            <span class="tool-name">@m.Key</span>
                            <span class="tool-meta">@m.Value calls</span>
                        </div>
                    }

                    <div class="panel-label spaced">Errors</div>
                    @if (_detail.ErrorTypes.Count == 0)
                    {
                        <div class="ok-note">No errors ✓</div>
                    }
                    else
                    {
                        @foreach (var e in _detail.ErrorTypes.OrderByDescending(e => e.Value))
                        {
                            <div class="tool-row err"><span class="tool-name">@e.Key</span><span class="tool-meta">@e.Value×</span></div>
                        }
                    }

                    <div class="panel-label spaced">Context</div>
                    <div class="kv"><span>repo</span><b>@(s.Repository ?? "—")</b></div>
                    <div class="kv"><span>branch</span><b>@(s.Branch ?? "—")</b></div>
                    <div class="kv"><span>agent</span><b>@(s.Agent ?? "—")</b></div>
                    <div class="kv"><span>started</span><b>@s.FirstSeen.ToLocalTime().ToString("HH:mm:ss")</b></div>
                </div>
            </div>
            }

            @* ---- What shipped: the session joined to its pull requests ---- *@
            @if (_detail.Outcomes is { Count: > 0 })
            {
                <div class="panel">
                    <div class="panel-head">
                        <div class="panel-label">Delivered outcome</div>
                        <div class="panel-sub">shown beside the score, not folded into it</div>
                    </div>
                    <div class="outcomes">
                        @foreach (var o in _detail.Outcomes)
                        {
                            <div class="outcome">
                                <div class="outcome-head">
                                    <span class="outcome-state state-@o.State">@o.State</span>
                                    <span class="outcome-title">#@o.Number @o.Title</span>
                                    <span class="outcome-confidence conf-@o.Confidence" title="@o.Reason">@o.Confidence confidence</span>
                                </div>
                                <div class="outcome-meta">
                                    @o.Branch · +@o.Additions/−@o.Deletions in @o.ChangedFiles file@(o.ChangedFiles == 1 ? "" : "s")
                                    @if (o.HoursToFirstReview is { } review)
                                    {
                                        <text> · first review after @FormatHours(review)</text>
                                    }
                                    @if (o.HoursToMerge is { } merge)
                                    {
                                        <text> · merged after @FormatHours(merge)</text>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            @if (_viewMode != ViewMode.Basic)
            {
                <div class="panel">
                    <div class="panel-head">
                        <div class="panel-label">Prompts &amp; responses</div>
                        @if (_detail.Transcript.Count > 0 && _canReadTranscripts)
                        {
                            <button class="btn" @onclick="() => _showChat = true">Open conversation</button>
                        }
                    </div>
                    @if (!_canReadTranscripts)
                    {
                        @* Transcript text is the sensitive payload — the conversation itself,
                           including anything pasted into it. Scores and turns stay visible. *@
                        <div class="empty">
                            Conversation content is restricted. Sign in with the admin password to read
                            captured prompts and responses; scores, turn analysis and aggregates are
                            available to every signed-in user.
                        </div>
                    }
                    else if (_detail.Transcript.Count == 0)
                    {
                        <div class="empty">
                            No captured content — Copilot only sends prompt/response text when content capture is enabled on the client, and only for chats started after enabling it.
                            <code>VS Code: "github.copilot.chat.otel.captureContent": true</code>
                            <code>CLI: OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=true (COPILOT_OTEL_CAPTURE_CONTENT does not exist)</code>
                        </div>
                    }
                    else
                    {
                        <div class="chat-summary">
                            <span class="ok-note">Content capture is active ✓</span>
                            @_detail.Transcript.Count exchange(s) recorded, latest at
                            @_detail.Transcript[^1].Time.ToLocalTime().ToString("HH:mm:ss").
                            Open the read-only conversation view to browse them.
                        </div>
                    }
                </div>
            }

            @if (_viewMode != ViewMode.Basic && (_viewMode == ViewMode.Full || _detail.Events.Count > 0))
            {
                <div class="panel">
                    <div class="panel-label">Event feed (live)</div>
                    <div class="feed">
                        @foreach (var e in _detail.Events)
                        {
                            <div class="feed-row kind-@e.Kind">
                                <span class="feed-time">@e.Time.ToLocalTime().ToString("HH:mm:ss")</span>
                                <span class="feed-kind">@e.Kind</span>
                                <span class="feed-text">@e.Summary</span>
                            </div>
                        }
                    </div>
                </div>
            }
            @if (_showChat && _canReadTranscripts)
            {
                <div class="modal-backdrop" @onclick="() => _showChat = false">
                    <div class="chat-window" role="dialog" aria-modal="true" aria-label="Conversation transcript, read only"
                         tabindex="-1" @ref="_chatWindowRef" @onkeydown="OnChatKeyDown" @onclick:stopPropagation="true">
                        <div class="chat-head">
                            <div>
                                <div class="panel-label">Conversation — read only</div>
                                <div class="chat-head-sub">@s.Id</div>
                            </div>
                            <button class="btn" aria-label="Close conversation" @onclick="() => _showChat = false">Close ✕</button>
                        </div>
                        <div class="chat-scroll" @ref="_chatScrollRef">
                            @foreach (var entry in _detail.Transcript)
                            {
                                <div class="turn-sep">@entry.Time.ToLocalTime().ToString("HH:mm:ss") · @entry.Model@(entry.Turn >= 0 ? $" · turn {entry.Turn + 1}" : "")</div>
                                @foreach (var m in Messages(entry))
                                {
                                    <div class="msg @RoleClass(m.Role)">
                                        <div class="msg-role">@m.Role</div>
                                        <div class="msg-bubble">@m.Text</div>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </section>
</div>
