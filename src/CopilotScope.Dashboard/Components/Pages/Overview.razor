@page "/overview"
@implements IDisposable
@inject CollectorClient Collector
@inject IJSRuntime JS

<PageTitle>CopilotScope — Overview</PageTitle>

<header class="topbar">
    <h1 class="brand">Copilot<span>Scope</span></h1>
    <nav class="nav">
        <a href="/">Sessions</a>
        <a href="/overview" class="active">Overview</a>
        <a href="/docs">Docs</a>
    </nav>
</header>

<div class="overview-main">

    @* Time range and cohort. Every axis here describes the tooling — repository, assistant,
       model. There is deliberately no developer axis; see docs/PRIVACY.md. *@
    <div class="panel filters no-print">
        <div class="filter-row">
            <span class="filter-label">Window</span>
            @foreach (var (label, value) in Ranges)
            {
                <button class="chip @(_days == value ? "active" : "")"
                        @onclick="() => SetRangeAsync(value)">@label</button>
            }
        </div>

        <div class="filter-row">
            <span class="filter-label">Cohort</span>

            <select value="@_repository" @onchange="e => SetRepositoryAsync(e.Value?.ToString())">
                <option value="">All repositories</option>
                @foreach (var r in _facets?.Repositories ?? []) { <option value="@r">@r</option> }
            </select>

            <select value="@_emitter" @onchange="e => SetEmitterAsync(e.Value?.ToString())">
                <option value="">All assistants</option>
                @foreach (var a in _facets?.Assistants ?? []) { <option value="@a">@a</option> }
            </select>

            <select value="@_model" @onchange="e => SetModelAsync(e.Value?.ToString())">
                <option value="">All models</option>
                @foreach (var m in _facets?.Models ?? []) { <option value="@m">@m</option> }
            </select>

            @if (!Cohort.IsEmpty)
            {
                <button class="chip" @onclick="ClearCohortAsync">Clear</button>
            }

            <span class="filter-spacer"></span>
            <a class="chip" href="@ExportUrl("cohorts")" download>Export cohorts (CSV)</a>
            <a class="chip" href="@ExportUrl("compare")" download>Export comparison (CSV)</a>
            <button class="chip" @onclick="PrintAsync">Print summary</button>
        </div>
    </div>

    @if (_overview is null)
    {
        <div class="empty big">Connecting to the collector…</div>
    }
    else if (_overview.Sessions == 0)
    {
        <div class="empty big">
            No sessions in this window@(Cohort.IsEmpty ? "" : $" for {Cohort.Describe()}").
            Widen the range, clear the cohort, or run the demo generator.
        </div>
    }
    else
    {
        var o = _overview;
        var totalTokens = o.InputTokens + o.OutputTokens;

        <div class="print-only print-head">
            <h2>CopilotScope summary — @RangeLabel</h2>
            <p>Cohort: @Cohort.Describe() · generated @DateTimeOffset.Now.ToString("yyyy-MM-dd HH:mm")</p>
        </div>

        @* The three questions a buyer actually asks, in the vocabulary they ask them in
           (utilization / impact / cost — the DX AI Measurement Framework). The tiles below
           are the same numbers; this row is what a director reads. *@
        <div class="panel">
            <div class="panel-label">Utilization · impact · cost — @RangeLabel</div>
            <div class="tiles hero">
                <div class="tile" data-tip="How much the fleet is being used: sessions and model calls in this window." tabindex="0">
                    <b>@o.Sessions</b><span>utilization — sessions</span>
                </div>
                <div class="tile" data-tip="Turns per session. Fewer turns for the same work means the assistant is resolving asks faster." tabindex="0">
                    <b>@PerSession(o.Turns, o.Sessions)</b><span>turns / session</span>
                </div>
                <div class="tile" data-tip="Mean composite quality across the cohort. Read it with the components, not alone." tabindex="0">
                    <b>@o.AvgQualityScore.ToString("0.0")</b><span>impact — avg quality</span>
                </div>
                <div class="tile" data-tip="Share of model and tool calls that failed. The cheapest impact signal there is." tabindex="0">
                    <b>@ErrorRate(o)</b><span>impact — error rate</span>
                </div>
                <div class="tile" data-tip="Total prompt + generated tokens. The closest thing to a bill this tool can see." tabindex="0">
                    <b>@FmtTokens(totalTokens)</b><span>cost — total tokens</span>
                </div>
                <div class="tile" data-tip="Tokens per session — the unit that stays comparable when volume changes." tabindex="0">
                    <b>@FmtTokens(o.Sessions == 0 ? 0 : totalTokens / o.Sessions)</b><span>cost — tokens / session</span>
                </div>
            </div>
        </div>

        @if (_comparison is { } cmp)
        {
            @* The buying question: did anything change. Same cohort, two windows, one table —
               instead of two dashboards and mental subtraction. *@
            <div class="panel">
                <div class="panel-label">
                    This window vs. the one before it — @Cohort.Describe()
                    (@cmp.BaselineSessions → @cmp.CurrentSessions sessions)
                </div>
                @if (cmp.Caveats.Count > 0)
                {
                    <div class="comparability-note" role="note">
                        @foreach (var caveat in cmp.Caveats) { <div>@caveat</div> }
                    </div>
                }
                <table class="delta-table">
                    <thead>
                        <tr><th>Metric</th><th>Before</th><th>Now</th><th>Change</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var d in cmp.Deltas)
                        {
                            <tr>
                                <td>@d.Metric</td>
                                <td class="num">@Fmt(d.Baseline)</td>
                                <td class="num">@Fmt(d.Current)</td>
                                <td class="num @DeltaClass(d)">
                                    @(d.Delta >= 0 ? "+" : "")@Fmt(d.Delta)
                                    @if (d.PercentChange is { } pct)
                                    {
                                        <i>(@(pct >= 0 ? "+" : "")@pct.ToString("0.#")%)</i>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <div class="tiles">
            <div class="tile" data-tip="Model calls in this window; ✗ = failed calls." tabindex="0"><b>@o.ChatCalls<i>@(o.ChatErrors > 0 ? $" ({o.ChatErrors}✗)" : "")</i></b><span>LLM calls</span></div>
            <div class="tile" data-tip="Agent tool executions; ✗ = failures." tabindex="0"><b>@o.ToolCalls<i>@(o.ToolErrors > 0 ? $" ({o.ToolErrors}✗)" : "")</i></b><span>tool calls</span></div>
            <div class="tile" data-tip="Prompt tokens served from cache instead of full reprocessing — effectively saved work and cost." tabindex="0"><b>@FmtTokens(o.CacheReadTokens)</b><span>cache read (saved)</span></div>
            <div class="tile" data-tip="Tokens written into the prompt cache — an upfront investment that pays off on subsequent calls." tabindex="0"><b>@FmtTokens(o.CacheCreationTokens)</b><span>cache written</span></div>
            <div class="tile" data-tip="Suggested edits kept vs discarded (VS Code and Claude Code only)." tabindex="0"><b>@o.EditsAccepted✓ @o.EditsRejected✗</b><span>edits</span></div>
            <div class="tile" data-tip="Explicit thumbs up/down (VS Code only — the CLI has no feedback UI)." tabindex="0"><b>👍@o.ThumbsUp 👎@o.ThumbsDown</b><span>feedback</span></div>
        </div>

        @if (_cohorts is { } c)
        {
            <div class="columns">
                @RollupPanel("By repository", c.ByRepository)
                @RollupPanel("By assistant", c.ByAssistant)
            </div>
            <div class="columns">
                @RollupPanel("By model", c.ByModel)
                @RollupPanel("By session kind", c.ByKind)
            </div>
        }

        <div class="columns no-print">
            <div class="panel">
                <div class="panel-label">Tokens per day</div>
                @{ var maxDay = Math.Max(1, o.Daily.Count > 0 ? o.Daily.Max(d => d.InputTokens + d.OutputTokens) : 1); }
                @foreach (var d in o.Daily)
                {
                    var dayTotal = d.InputTokens + d.OutputTokens;
                    <div class="tool-row">
                        <span class="tool-name">@d.Date.ToString("yyyy-MM-dd")</span>
                        <div class="bar wide"><span style="width:@(Pct(1.0 * dayTotal / maxDay))%"></span></div>
                        <span class="tool-meta">@FmtTokens(dayTotal) · @d.Sessions session(s)</span>
                    </div>
                }
            </div>

            <div class="panel">
                <div class="panel-label">Calls per model</div>
                @{ var maxModel = Math.Max(1, o.ModelCalls.Count > 0 ? o.ModelCalls.Values.Max() : 1); }
                @foreach (var m in o.ModelCalls.OrderByDescending(m => m.Value))
                {
                    <div class="tool-row">
                        <span class="tool-name">@m.Key</span>
                        <div class="bar wide"><span style="width:@(Pct(1.0 * m.Value / maxModel))%"></span></div>
                        <span class="tool-meta">@m.Value</span>
                    </div>
                }
            </div>
        </div>

        <div class="panel no-print">
            <div class="panel-label">Top sessions by token burn</div>
            @{ var maxTop = Math.Max(1, o.TopSessions.Count > 0 ? o.TopSessions.Max(t => t.TotalTokens) : 1); }
            @foreach (var t in o.TopSessions)
            {
                @* Deep link to the named session, not to the session list. The old link went to
                   "/" and left the reader to find the row themselves. *@
                <div class="tool-row">
                    <a class="tool-name link" href="@($"/sessions/{Uri.EscapeDataString(t.Id)}")">@t.Id</a>
                    <div class="bar wide"><span style="width:@(Pct(1.0 * t.TotalTokens / maxTop))%"></span></div>
                    <span class="tool-meta">@FmtTokens(t.TotalTokens) · quality @t.QualityScore.ToString("0")</span>
                </div>
            }
        </div>
    }
</div>

@code {
    private static readonly (string Label, int Days)[] Ranges =
        [("7 days", 7), ("30 days", 30), ("90 days", 90), ("All", 0)];

    private OverviewDto? _overview;
    private CohortReportDto? _cohorts;
    private ComparisonReportDto? _comparison;
    private FacetsDto? _facets;

    private int _days = 30;
    private string? _repository;
    private string? _emitter;
    private string? _model;

    private readonly CancellationTokenSource _cts = new();

    private CohortQuery Cohort => new(_repository, _emitter, _model);
    private string RangeLabel => _days > 0 ? $"last {_days} days" : "all history";

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
        _ = PollAsync();
    }

    private async Task RefreshAsync()
    {
        var days = _days > 0 ? _days : (int?)null;
        var cohort = Cohort;

        _overview = await Collector.GetOverviewAsync(days, cohort, _cts.Token) ?? _overview;
        _cohorts = await Collector.GetCohortsAsync(days, cohort, _cts.Token);
        _facets = await Collector.GetFacetsAsync(days, _cts.Token) ?? _facets;
        // A comparison needs a bounded current window to infer the preceding one from, so
        // "All" has nothing to compare against and the panel stays off rather than inventing
        // a baseline.
        _comparison = _days > 0 ? await Collector.GetComparisonAsync(_days, cohort, _cts.Token) : null;
    }

    private async Task PollAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(10));
        try
        {
            while (await timer.WaitForNextTickAsync(_cts.Token))
            {
                await RefreshAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
    }

    private Task SetRangeAsync(int days) { _days = days; return RefreshAsync(); }
    private Task SetRepositoryAsync(string? v) { _repository = Blank(v); return RefreshAsync(); }
    private Task SetEmitterAsync(string? v) { _emitter = Blank(v); return RefreshAsync(); }
    private Task SetModelAsync(string? v) { _model = Blank(v); return RefreshAsync(); }

    private Task ClearCohortAsync()
    {
        _repository = _emitter = _model = null;
        return RefreshAsync();
    }

    private static string? Blank(string? value) => string.IsNullOrWhiteSpace(value) ? null : value;

    /// <summary>The export runs through this app, not the collector: the API key lives
    /// server-side and never reaches the browser.</summary>
    private string ExportUrl(string report) =>
        $"/export/{report}.csv?days={(_days > 0 ? _days : 3650)}{Cohort.ToQuery()}";

    /// <summary>Browser print. The @@media print rules below reduce the page to the one-page
    /// summary — the headline row, the comparison and the rollups — so what comes out of the
    /// printer is the thing a lead brings to a meeting, not a screenshot of a dashboard.</summary>
    private async Task PrintAsync()
    {
        try { await JS.InvokeVoidAsync("window.print"); }
        catch (JSException) { /* no browser (prerender) — the button simply does nothing */ }
    }

    private RenderFragment RollupPanel(string title, List<CohortRowDto> rows) => @<div class="panel">
        <div class="panel-label">@title</div>
        @if (rows.Count == 0)
        {
            <div class="empty">Nothing in this window.</div>
        }
        else
        {
            var maxTokens = Math.Max(1, rows.Max(r => r.InputTokens + r.OutputTokens));
            @foreach (var r in rows.Take(12))
            {
                var tokens = r.InputTokens + r.OutputTokens;
                <div class="tool-row">
                    <span class="tool-name" title="@r.Value">@r.Value</span>
                    <div class="bar wide"><span style="width:@(Pct(1.0 * tokens / maxTokens))%"></span></div>
                    <span class="tool-meta">
                        @FmtTokens(tokens) · @r.Sessions session(s)
                        @* Averages below the floor are reported as "—": a mean over two
                           sessions is one session wearing a mean's clothes. *@
                        @if (r.Sessions >= 3)
                        {
                            <text> · q @r.AvgQualityScore.ToString("0.0")</text>
                        }
                        else
                        {
                            <text> · q —</text>
                        }
                        @if (r.ErrorRate > 0)
                        {
                            <text> · @((r.ErrorRate * 100).ToString("0.#"))% err</text>
                        }
                    </span>
                </div>
            }
        }
    </div>;

    private static string DeltaClass(MetricDeltaDto d)
    {
        // Direction is metric-specific: fewer errors is better, more quality is better, and
        // "tokens per session" is genuinely ambiguous — a cheaper session and a session that
        // gave up look the same from here — so it gets no colour rather than a misleading one.
        var lowerIsBetter = d.Metric.Contains("error", StringComparison.OrdinalIgnoreCase);
        var neutral = d.Metric.Contains("token", StringComparison.OrdinalIgnoreCase)
                   || d.Metric.Contains("sessions", StringComparison.OrdinalIgnoreCase);
        if (neutral || d.Delta == 0) return "";
        var good = lowerIsBetter ? d.Delta < 0 : d.Delta > 0;
        return good ? "delta-good" : "delta-bad";
    }

    private static string PerSession(int total, int sessions) =>
        sessions == 0 ? "—" : ((double)total / sessions).ToString("0.0");

    private static string ErrorRate(OverviewDto o)
    {
        var calls = o.ChatCalls + o.ToolCalls;
        return calls == 0 ? "—" : ((double)(o.ChatErrors + o.ToolErrors) / calls * 100).ToString("0.#") + "%";
    }

    private static string Fmt(double value) =>
        Math.Abs(value) >= 1000 ? value.ToString("#,0") : value.ToString("0.##");

    private static string Pct(double v) =>
        (Math.Clamp(v, 0, 1) * 100).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);

    private static string FmtTokens(long n) => n switch
    {
        >= 1_000_000 => (n / 1_000_000.0).ToString("0.00") + "M",
        >= 1_000 => (n / 1_000.0).ToString("0.0") + "k",
        _ => n.ToString()
    };

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
